# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.

# --- Public (bundled into the site) ---
# WhatsApp number in international format, digits only (Indonesia: 62…, drop the leading 0).
# Left empty, the studio number in src/config.js (6282299417885) is used.
VITE_WHATSAPP_NUMBER=

# Final public URL, used for canonical / Open Graph / JSON-LD tags. No trailing slash.
SITE_URL=https://end-yourcreative.vercel.app

# Optional: post the inquiry form somewhere other than the bundled /api/inquiry function.
# VITE_INQUIRY_ENDPOINT=

# --- Server only (used by api/inquiry.js; never exposed to the browser) ---
RESEND_API_KEY=
# Left empty, inquiries go to ahmadshowi15@gmail.com.
INQUIRY_TO_EMAIL=
# Must be a sender on a domain verified in Resend. Leave empty to use Resend's test sender.
INQUIRY_FROM_EMAIL=
